[Unit]
Description=GoalVision PREMATCH bounded daily learning eligibility and research
[Service]
Type=oneshot
User=arvis
WorkingDirectory=/home/arvis/GoalVisionAI
EnvironmentFile=/etc/goalvision-prematch-release.conf
ExecStart=/home/arvis/GoalVisionAI/.venv/bin/python -P -m app.adaptive_lab.prematch research --database /home/arvis/GoalVisionAI/var/adaptive_lab/audit.db --json
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
