[Unit]
Description=GoalVision independent PREMATCH ADMIN evidence monitor
ConditionPathExists=!/var/lib/goalvision-admin-alerts/DISABLED

[Service]
Type=oneshot
User=goalvision-admin-alerts
Group=goalvision-admin-alerts
WorkingDirectory=/opt/goalvision-admin-alerts
ExecStart=/usr/bin/python3 -I /opt/goalvision-admin-alerts/run.py --config /etc/goalvision-admin-alerts/admin-alerts.json
TimeoutStartSec=45
KillMode=control-group
StateDirectory=goalvision-admin-alerts
StateDirectoryMode=0700
UMask=0077
Nice=15
IOSchedulingClass=idle
CPUQuota=20%
MemoryMax=128M
TasksMax=16
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/arvis/GoalVisionAI/var /var/log/goalvision-prematch
ReadWritePaths=/var/lib/goalvision-admin-alerts
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
